<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.julius_szumski_3137163_dissertaion_project">

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Critter Collector"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Julius_Szumski_3137163Dissertaion_Project">
        <activity
            android:name=".TradeActivity"
            android:exported="false"
            android:label="@string/title_activity_trade"
            android:theme="@style/Theme.Julius_Szumski_3137163Dissertaion_Project" />
        <activity
            android:name=".LogIn"
            android:exported="true"
            android:label="@string/title_activity_log_in"
            android:theme="@style/Theme.Julius_Szumski_3137163Dissertaion_Project">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CollectionActivity"
            android:exported="false"
            android:label="@string/title_activity_collection"
            android:theme="@style/Theme.Julius_Szumski_3137163Dissertaion_Project" />
        <activity
            android:name=".PlayerSearchActivity"
            android:exported="false"
            android:label="@string/title_activity_player_search"
            android:theme="@style/Theme.Julius_Szumski_3137163Dissertaion_Project" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Julius_Szumski_3137163Dissertaion_Project" />
    </application>

</manifest>